{
  "name": "easyecom-storefront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:poc": "node scripts/build-poc.mjs",
    "start": "next start --hostname 127.0.0.1",
