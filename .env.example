# Local storefront design only. No payment or customer secrets are required.
NEXT_PUBLIC_STORE_BRAND=apres
# Optional independent build directory for second-brand verification:
# STOREFRONT_BUILD_DIR=.next-desk

# No live supplier adapter is installed. Future provider credentials must stay
# server-only and must NEVER use a NEXT_PUBLIC_ prefix. Keep real values out of Git.

# First-ten-order pilot: Stripe-hosted checkout + MANUAL supplier ordering.
# Defaults to off. Follow docs/FIRST_TEN_ORDERS.md before changing to test/live.
PILOT_MODE=off
# Stop new sessions with false; also expire previously opened Stripe sessions.
PILOT_ACCEPTING_ORDERS=false
PILOT_BRAND=apres
PILOT_SITE_URL=http://127.0.0.1:3000
STRIPE_SECRET_KEY=
# Map only approved pilot variants. Unique, one-time Stripe Prices are required.
PILOT_PRICE_IDS_JSON={}
PILOT_SHIPPING_RATE_ID=
PILOT_ALLOWED_COUNTRIES=
# Explicit merchant decision; enabling Stripe Tax also needs account configuration.
PILOT_AUTOMATIC_TAX=
# Public copy only. Never put private customer/billing/account data in this JSON.
PILOT_PUBLIC_COPY_JSON={}
# Set true only after merchant review of real products, costs, policies, tests and account.
PILOT_LAUNCH_APPROVED=false
